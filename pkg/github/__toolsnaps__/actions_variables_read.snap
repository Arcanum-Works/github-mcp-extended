{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Read Actions variables"
  },
  "description": "Read GitHub Actions variables for a repository, one of its environments, or the organization. Variables are plain configuration, not secrets, so their values are returned.",
  "inputSchema": {
    "properties": {
      "environment_name": {
        "description": "Environment name. Required when scope is 'environment'.",
        "type": "string"
      },
      "method": {
        "description": "The method to execute: 'list' for every variable in scope, 'get' for one by name",
        "enum": [
          "list",
          "get"
        ],
        "type": "string"
      },
      "name": {
        "description": "Variable name. Required for 'get'.",
        "type": "string"
      },
      "org": {
        "description": "Organization login. Defaults to owner when scope is 'organization'.",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization name)",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name. Not needed when scope is 'organization'.",
        "type": "string"
      },
      "scope": {
        "description": "Where the value lives: on the repository, on one of its environments, or on the organization. Defaults to 'repository'.",
        "enum": [
          "repository",
          "environment",
          "organization"
        ],
        "type": "string"
      }
    },
    "required": [
      "method",
      "owner"
    ],
    "type": "object"
  },
  "name": "actions_variables_read"
}