{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "readOnlyHint": false,
    "title": "Write Actions secrets"
  },
  "description": "Store or remove a GitHub Actions secret on a repository or one of its environments. The value is encrypted to the repository's public key before it leaves this server, and is never echoed back: the result reports only the secret's name. Creating and updating share one method, so writing an existing name replaces its value.",
  "inputSchema": {
    "properties": {
      "environment_name": {
        "description": "Environment name. Required when scope is 'environment'.",
        "type": "string"
      },
      "method": {
        "description": "Operation to perform: 'create_or_update' or 'delete'",
        "enum": [
          "create_or_update",
          "delete"
        ],
        "type": "string"
      },
      "name": {
        "description": "Secret name, e.g. 'DEPLOY_TOKEN'.",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization name)",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "scope": {
        "description": "Where the value lives: on the repository, or on one of its environments. Defaults to 'repository'. Organization scope is not available on this tool.",
        "enum": [
          "repository",
          "environment"
        ],
        "type": "string"
      },
      "value": {
        "description": "The secret value. Required for 'create_or_update'. It is encrypted before transmission and never returned by any tool.",
        "type": "string"
      }
    },
    "required": [
      "method",
      "owner",
      "repo",
      "name"
    ],
    "type": "object"
  },
  "name": "actions_secret_write"
}