{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List milestones"
  },
  "description": "List milestones in a GitHub repository. Use this to discover milestone numbers before assigning issues to a milestone.",
  "inputSchema": {
    "properties": {
      "direction": {
        "description": "Sort direction. Defaults to 'asc'.",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization name)",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "sort": {
        "description": "Sort field. Defaults to 'due_on'.",
        "enum": [
          "due_on",
          "completeness"
        ],
        "type": "string"
      },
      "state": {
        "description": "Filter by milestone state. Defaults to 'open'.",
        "enum": [
          "open",
          "closed",
          "all"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_milestones"
}