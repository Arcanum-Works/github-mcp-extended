{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Read Actions secret metadata"
  },
  "description": "List the GitHub Actions secrets configured on a repository or one of its environments, and when each was last updated. Only names and timestamps are returned: GitHub stores secret values write-only and no API can read one back. To see a value, look at what the workflow does with it.",
  "inputSchema": {
    "properties": {
      "environment_name": {
        "description": "Environment name. Required when scope is 'environment'.",
        "type": "string"
      },
      "method": {
        "description": "The method to execute: 'list' for every secret in scope, 'get' for one secret's metadata by name",
        "enum": [
          "list",
          "get"
        ],
        "type": "string"
      },
      "name": {
        "description": "Secret name. Required for 'get'.",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization name)",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "scope": {
        "description": "Where the value lives: on the repository, or on one of its environments. Defaults to 'repository'.",
        "enum": [
          "repository",
          "environment"
        ],
        "type": "string"
      }
    },
    "required": [
      "method",
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "actions_secrets_read"
}