{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "readOnlyHint": false,
    "title": "Change Actions configuration"
  },
  "description": "Change a repository's GitHub Actions configuration: enable or disable Actions, restrict which actions workflows may use, set what the default GITHUB_TOKEN can do, and enable or disable an individual workflow. Use 'actions_run_trigger' to run, re-run or cancel workflows; this changes the policy around them.",
  "inputSchema": {
    "properties": {
      "allowed_actions": {
        "description": "Which actions workflows may use: 'all', 'local_only' for actions defined in this repository, or 'selected' for the allow-list set by 'set_allowed_actions'. Used by 'set_permissions'.",
        "enum": [
          "all",
          "local_only",
          "selected"
        ],
        "type": "string"
      },
      "can_approve_pull_request_reviews": {
        "description": "Allow GitHub Actions to approve pull requests. Used by 'set_workflow_permissions'.",
        "type": "boolean"
      },
      "default_workflow_permissions": {
        "description": "What the default GITHUB_TOKEN may do in a workflow. Used by 'set_workflow_permissions'.",
        "enum": [
          "read",
          "write"
        ],
        "type": "string"
      },
      "enabled": {
        "description": "Whether GitHub Actions runs in this repository at all. Used by 'set_permissions'.",
        "type": "boolean"
      },
      "github_owned_allowed": {
        "description": "Allow actions published by GitHub. Used by 'set_allowed_actions'.",
        "type": "boolean"
      },
      "method": {
        "description": "The operation to perform:\n- set_permissions: enable or disable Actions, and choose which actions may be used\n- set_allowed_actions: the allow-list applied when allowed_actions is 'selected'\n- set_workflow_permissions: what the default GITHUB_TOKEN can do\n- enable_workflow / disable_workflow: switch one workflow on or off",
        "enum": [
          "set_permissions",
          "set_allowed_actions",
          "set_workflow_permissions",
          "enable_workflow",
          "disable_workflow"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner (username or organization name)",
        "type": "string"
      },
      "patterns_allowed": {
        "description": "Specific actions to allow, e.g. ['octo-org/*', 'actions/checkout@v4']. Pass an empty array to allow no third-party actions. Used by 'set_allowed_actions'.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "verified_allowed": {
        "description": "Allow actions from verified creators. Used by 'set_allowed_actions'.",
        "type": "boolean"
      },
      "workflow": {
        "description": "Workflow file name, e.g. 'deploy.yml', or its numeric ID. Required for 'enable_workflow' and 'disable_workflow'.",
        "type": "string"
      }
    },
    "required": [
      "method",
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "actions_config_write"
}